[Desktop Entry]
Version=1.0
Name=Navegador
GenericName=Navegador de internet
Comment=Navegar na internet
Exec=navegador %U
StartupNotify=true
StartupWMClass=navegador
Terminal=false
Icon=navegador
Type=Application
Categories=Network;WebBrowser;
MimeType=text/html;text/xml;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;application/pdf;
Actions=nova-janela;nova-janela-anonima;

[Desktop Action nova-janela]
Name=Nova janela
Exec=navegador

[Desktop Action nova-janela-anonima]
Name=Nova janela anônima
Exec=navegador --incognito
