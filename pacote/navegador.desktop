[Desktop Entry]
# O nome antigo do Norte. Escondido do menu de apps: só mantém o "navegador
# padrão" de quem já tinha o navegador.desktop escolhido (links continuam
# abrindo no Norte).
Version=1.0
Name=Norte
GenericName=Navegador de internet
Exec=norte %U
StartupWMClass=norte
Terminal=false
Icon=norte
Type=Application
Categories=Network;WebBrowser;
MimeType=text/html;text/xml;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;application/pdf;
NoDisplay=true
