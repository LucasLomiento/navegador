   mostVisitedElement.theme = theme.mostVisited;
 });
 handler.updateTheme();
+
+// navegador: hora e data no centro da nova aba (no idioma do navegador).
+function mostrarHora() {
+  const agora = new Date();
+  const idioma = document.documentElement.lang || undefined;
+  const hora = document.querySelector('#hora');
+  const data = document.querySelector('#data');
+  if (hora) {
+    hora.textContent = agora.toLocaleTimeString(
+        idioma, {hour: '2-digit', minute: '2-digit'});
+  }
+  if (data) {
+    data.textContent = agora.toLocaleDateString(
+        idioma, {weekday: 'long', day: 'numeric', month: 'long'});
+  }
+}
+mostrarHora();
+// Acerta no começo de cada minuto.
+setTimeout(() => {
+  mostrarHora();
+  setInterval(mostrarHora, 60 * 1000);
+}, (60 - new Date().getSeconds()) * 1000);
+
+/* eslint-disable no-restricted-properties */
+// navegador: o que aparece na nova aba (inicio.cc guarda nas prefs do
+// perfil). As mudanças feitas nas Configurações chegam por
+// 'navegador-inicio'.
+interface OpcoesDoInicio {
+  hora: boolean;
+  data: boolean;
+  atalhos: number;  // 0 mais visitados, 1 meus atalhos, 2 nenhum.
+}
+
+function elemento<T extends HTMLElement>(seletor: string): T {
+  const achado = document.querySelector<T>(seletor);
+  assert(achado);
+  return achado;
+}
+
+const botao = elemento<HTMLButtonElement>('#personalizar');
+const painel = elemento<HTMLElement>('#painel');
+const opcaoHora = elemento<HTMLInputElement>('#opcao-hora');
+const opcaoData = elemento<HTMLInputElement>('#opcao-data');
+const segmentos =
+    Array.from(painel.querySelectorAll<HTMLButtonElement>('[data-atalhos]'));
+
+function aplicar(opcoes: OpcoesDoInicio) {
+  elemento('#hora').hidden = !opcoes.hora;
+  elemento('#data').hidden = !opcoes.data;
+  opcaoHora.checked = opcoes.hora;
+  opcaoData.checked = opcoes.data;
+  for (const segmento of segmentos) {
+    const escolhido = Number(segmento.dataset['atalhos']) === opcoes.atalhos;
+    segmento.setAttribute('aria-checked', String(escolhido));
+    segmento.tabIndex = escolhido ? 0 : -1;
+  }
+  elemento('#dica-meus').hidden = opcoes.atalhos !== 1;
+  // Sem hora e sem data, os atalhos sobem pro meio.
+  elemento('cr-most-visited').style.marginTop =
+      opcoes.hora || opcoes.data ? '' : '0';
+}
+
+aplicar({
+  hora: loadTimeData.getBoolean('navegadorHora'),
+  data: loadTimeData.getBoolean('navegadorData'),
+  atalhos: loadTimeData.getInteger('navegadorAtalhos'),
+});
+addWebUiListener('navegador-inicio', aplicar);
+chrome.send('navegadorInicioPronto');
+
+function abrirPainel(aberto: boolean) {
+  painel.hidden = !aberto;
+  botao.setAttribute('aria-expanded', String(aberto));
+  if (aberto) {
+    opcaoHora.focus();
+  }
+}
+
+botao.addEventListener('click', () => abrirPainel(painel.hidden));
+document.addEventListener('pointerdown', e => {
+  const alvo = e.target as Node;
+  if (!painel.hidden && !painel.contains(alvo) && !botao.contains(alvo)) {
+    abrirPainel(false);
+  }
+});
+document.addEventListener('keydown', e => {
+  if (e.key === 'Escape' && !painel.hidden) {
+    abrirPainel(false);
+    botao.focus();
+  }
+});
+
+opcaoHora.addEventListener('change', () => {
+  chrome.send('navegadorInicioDefinir', ['hora', opcaoHora.checked]);
+});
+opcaoData.addEventListener('change', () => {
+  chrome.send('navegadorInicioDefinir', ['data', opcaoData.checked]);
+});
+for (const segmento of segmentos) {
+  segmento.addEventListener('click', () => {
+    chrome.send(
+        'navegadorInicioDefinir',
+        ['atalhos', Number(segmento.dataset['atalhos'])]);
+  });
+}
+// Setas trocam a escolha, como num grupo de rádio.
+elemento('#segmentos').addEventListener('keydown', e => {
+  if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') {
+    return;
+  }
+  const atual = segmentos.findIndex(
+      segmento => segmento.getAttribute('aria-checked') === 'true');
+  const proximo = (atual + (e.key === 'ArrowRight' ? 1 : -1) +
+                   segmentos.length) %
+      segmentos.length;
+  segmentos[proximo]!.click();
+  segmentos[proximo]!.focus();
+  e.preventDefault();
+});
