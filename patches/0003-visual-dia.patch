+            !model->user_input_in_progress() && url.SchemeIsHTTPOrHTTPS() &&
+            !is_popup_mode_;
+  if (mostrar == endereco_inteiro_) {
+    return;
+  }
+  endereco_inteiro_ = mostrar;
+  if (mostrar) {
+    // Domínio claro e o resto apagado (o EmphasizeURLComponents faz isso).
+    omnibox_view_->SetWindowTextAndCaretPos(
+        url_formatter::FormatUrl(
+            url,
+            url_formatter::kFormatUrlOmitDefaults |
+                url_formatter::kFormatUrlOmitHTTPS |
+                url_formatter::kFormatUrlOmitTrivialSubdomains,
+            base::UnescapeRule::NORMAL, nullptr, nullptr, nullptr),
+        0, /*update_popup=*/false, /*notify_text_changed=*/false);
+    omnibox_view_->EmphasizeURLComponents();
+  } else {
+    omnibox_view_->RevertAll();
+  }
 }
 
