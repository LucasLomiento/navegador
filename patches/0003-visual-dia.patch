+
+int VerticalTabStripRegionView::LarguraCheiaNaAnimacao() const {
+  const auto* controller =
+      BrowserAnimationController::From(browser_view()->browser());
+  if (!controller) {
+    return 0;
+  }
+  const auto motion =
+      controller->GetCurrentMotion(TabStripAnimations::kVerticalTabStrip);
+  if (motion == TabStripAnimations::kExpand ||
+      motion == TabStripAnimations::kCollapse) {
+    return uncollapsed_width();
+  }
+  // A lateral por cima da página tem a largura padrão (como o layout da
+  // janela, browser_view_tabbed_layout_impl.cc).
+  if (motion == TabStripAnimations::kExpandOnHover ||
+      motion == TabStripAnimations::kCollapseOnHover) {
+    return tabs::kVerticalTabStripDefaultUncollapsedWidth;
+  }
+  return 0;
+}
+
+void VerticalTabStripRegionView::FimDaFolga() {
+  if (navegador::espacos::AbrirInteira(Perfil()) &&
+      abrindo_ate_ > base::TimeTicks::Now()) {
+    mouse_exit_timer_.Start(
+        FROM_HERE, abrindo_ate_ - base::TimeTicks::Now(),
+        base::BindOnce(&VerticalTabStripRegionView::FimDaFolga,
+                       base::Unretained(this)));
+    return;
+  }
+  // Aberta pela saída na borda, ou com um menu dela aberto: espera mais.
+  base::TimeDelta falta = segurar_ate_ - base::TimeTicks::Now();
+  if (views::MenuController::GetActiveInstance()) {
+    falta = std::max(falta, base::Milliseconds(100));
+  }
+  // A bolha de downloads abre ancorada no botão do pé da lateral.
+  if (auto* downloads =
+          DownloadToolbarUIController::From(browser_view()->browser());
+      downloads && downloads->IsShowingDetails()) {
+    mouse_exit_timer_.Start(
+        FROM_HERE, base::Milliseconds(200),
+        base::BindOnce(&VerticalTabStripRegionView::FimDaFolga,
+                       base::Unretained(this)));
+    return;
+  }
+  if (!segurar_ate_.is_null() && falta.is_positive()) {
+    mouse_exit_timer_.Start(
+        FROM_HERE, falta,
+        base::BindOnce(&VerticalTabStripRegionView::FimDaFolga,
+                       base::Unretained(this)));
+    return;
+  }
+  if (views::MenuController::GetActiveInstance()) {
+    mouse_exit_timer_.Start(
+        FROM_HERE, base::Milliseconds(100),
+        base::BindOnce(&VerticalTabStripRegionView::FimDaFolga,
+                       base::Unretained(this)));
+    return;
+  }
+  segurar_ate_ = base::TimeTicks();
+  folga_acabou_ = true;
+  UpdateExpandOnHoverState(std::nullopt);
+  folga_acabou_ = false;
+}
+
+void VerticalTabStripRegionView::SaidaDaJanela::OnMouseEvent(
+    ui::MouseEvent* event) {
+  // Só a saída de verdade (o evento da plataforma, na janela raiz). Passar
+  // da lateral pra página (outra janela do aura, a da página) também gera
+  // saídas, mas nas janelas de dentro.
+  if (event->type() == ui::EventType::kMouseExited &&
+      event->target() == lateral_->janela_observada_.get() &&
+      !(event->flags() & ui::EF_IS_SYNTHESIZED)) {
+    lateral_->SaiuDaJanela(event->root_location());
+  }
+}
+
+// O Zen faz o mesmo: o ponteiro saiu da janela pela borda esquerda, perto da
+// lateral escondida (jogado pro canto da tela, além do vão entre as janelas).
+// A lateral abre e fica 1 s; voltando pra cima dela, segue como sempre.
+void VerticalTabStripRegionView::SaiuDaJanela(const gfx::Point& ponto) {
+  if (!GetWidget() || !state_controller_->ShouldDisplayVerticalTabs() ||
+      !state_controller_->IsCollapsed() ||
+      !state_controller_->IsExpandOnHoverEnabled() ||
+      !navegador::espacos::MostrarNaBorda(Perfil()) || !IsFrameActive()) {
+    return;
+  }
+  // O Zen faz o mesmo: o ponteiro saiu pela borda esquerda da janela (jogado
+  // pro canto da tela, além do vão entre as janelas) abre a lateral.
+  constexpr int kDistanciaDaBorda = 10;
+  const bool pela_esquerda = ponto.x() <= kDistanciaDaBorda;
+  if (!is_expanded_on_hover_ && !pela_esquerda) {
+    return;
+  }
+  // Aberta (ou abrindo pela borda): espera a folga de fora da janela.
+  if (!is_expanded_on_hover_) {
+    AnimateExpandOnHover(/*expand=*/true);
+  }
+  ContarFolga(
+      base::Milliseconds(navegador::espacos::EsconderForaMs(Perfil())));
+  segurar_ate_ = base::TimeTicks::Now() + mouse_exit_timer_.GetCurrentDelay();
+}
+
+void VerticalTabStripRegionView::ContarFolga(base::TimeDelta folga) {
+  // Passou rápido pela borda: termina de abrir antes de contar a folga
+  // (Configurações do Navegador → Lateral → abrir inteira).
+  if (navegador::espacos::AbrirInteira(Perfil())) {
+    folga += std::max(base::TimeDelta(),
+                      abrindo_ate_ - base::TimeTicks::Now());
+  }
+  if (!folga.is_positive()) {
+    FimDaFolga();
+    return;
+  }
+  mouse_exit_timer_.Start(
+      FROM_HERE, folga,
+      base::BindOnce(&VerticalTabStripRegionView::FimDaFolga,
+                     base::Unretained(this)));
+}
